{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pip install -r requirements-build.txt",
  "buildCommand": "python3 scripts/build.py && python3 scripts/check_links.py",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "trailingSlash": true,
  "headers": [
    { "source": "/static/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }] }
  ]
}
