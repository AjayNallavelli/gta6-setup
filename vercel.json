{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "python3 -m venv /tmp/venv && /tmp/venv/bin/pip install -r requirements-build.txt",
  "buildCommand": "/tmp/venv/bin/python scripts/build.py && /tmp/venv/bin/python scripts/check_links.py",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}
